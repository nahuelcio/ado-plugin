{
  "name": "@cioffinahuel/opencode-ado",
  "version": "0.9.3",
  "description": "Azure DevOps CLI for OpenCode/Pi — PR reviews, profiles",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ado": "dist/bin/opencode-ado.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.tsx"
    }
  },
  "oc-plugin": [
    "server",
    "tui"
  ],
  "pi": {
    "extensions": [
      "./dist/pi-entry.js"
    ]
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node scripts/prepare-tui-dist.mjs",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "sync:local": "npm run build && node dist/bin/opencode-ado.js sync-local",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opentui/core": "^0.5.11",
    "@opentui/solid": "^0.5.11",
    "solid-js": "1.9.12",
    "smol-toml": "^1.3.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.29",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "typebox": "1.3.28"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@opencode-ai/plugin": "^1.18.29",
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^4",
    "typebox": "^1.3.28",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "glob": "^13.0.0",
    "node-domexception": "^2.0.0",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "opencode",
    "pi-package",
    "azure-devops",
    "pull-request",
    "code-review",
    "plugin",
    "sidebar"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nahuelcio/azure-devops-cli-go.git",
    "directory": "opencode-plugin"
  }
}
